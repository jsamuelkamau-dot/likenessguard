# ── LikenessGuard v2 — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── AWS Configuration ─────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID

# ── API Gateway ───────────────────────────────────────────────────────────────
API_BASE_URL=https://YOUR_API_GATEWAY_ID.execute-api.us-east-1.amazonaws.com/v1

# ── DynamoDB Tables ───────────────────────────────────────────────────────────
CONSENT_REGISTRY_TABLE=LikenessGuard-ConsentRegistry
AUDIT_LOG_TABLE=LikenessGuard-AuditLog
FEDERATION_TABLE=LikenessGuard-Federation
SUSPENSION_TABLE=LikenessGuard-Suspensions

# ── S3 Buckets ────────────────────────────────────────────────────────────────
PHOTO_BUCKET=likenessguard-photos-YOUR_ACCOUNT_ID
JWKS_BUCKET=likenessguard-jwks-YOUR_ACCOUNT_ID
AUDIT_ARCHIVE_BUCKET=likenessguard-audit-archive-YOUR_ACCOUNT_ID

# ── KMS ───────────────────────────────────────────────────────────────────────
KMS_SIGNING_KEY_ARN=arn:aws:kms:us-east-1:YOUR_ACCOUNT_ID:key/YOUR_KEY_ID
KMS_KEY_ALIAS=alias/likenessguard-pof-signing

# ── OpenSearch Serverless ─────────────────────────────────────────────────────
OPENSEARCH_ENDPOINT=YOUR_COLLECTION_ID.us-east-1.aoss.amazonaws.com
USE_OPENSEARCH=true

# ── Bedrock ───────────────────────────────────────────────────────────────────
BEDROCK_REGION=us-east-1

# ── JWKS / CloudFront ─────────────────────────────────────────────────────────
JWKS_URL=https://YOUR_CLOUDFRONT_DOMAIN/.well-known/jwks.json

# ── Similarity Thresholds ─────────────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.85

# ── Lambda Function Names ─────────────────────────────────────────────────────
ANOMALY_AGENT_FN=LikenessGuard-AnomalyAgent
ORCHESTRATOR_FN=LikenessGuard-ConsentOrchestrator
POLICY_REASONER_FN=LikenessGuard-PolicyReasoner

# ── Edge (Greengrass) ─────────────────────────────────────────────────────────
LG_API_ENDPOINT=https://YOUR_API_GATEWAY_ID.execute-api.us-east-1.amazonaws.com/v1
LG_SIMILARITY_THRESHOLD=0.85
LG_CACHE_MAX_ENTRIES=10000
LG_SYNC_INTERVAL=300
LG_DB_PATH=/var/lib/likenessguard/edge_cache.db

# ── MCP Server (Claude.ai Integration) ───────────────────────────────────────
MCP_PORT=8080

# ── Dashboard ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://YOUR_API_GATEWAY_ID.execute-api.us-east-1.amazonaws.com/v1
