# ── LikenessGuard v2 — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── AWS Configuration ─────────────────────────────────────────────────────────
# Your AWS region — LikenessGuard requires us-east-1 for Bedrock model access
AWS_REGION=us-east-1

# Your 12-digit AWS account ID (find it at https://console.aws.amazon.com/billing/home)
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID

# ── API Gateway ───────────────────────────────────────────────────────────────
# The base URL for the deployed API Gateway (output from `make deploy`)
API_BASE_URL=https://YOUR_API_GATEWAY_ID.execute-api.us-east-1.amazonaws.com/v1

# ── DynamoDB Tables ───────────────────────────────────────────────────────────
# Table names created by CloudFormation — change only if you customized the stack
CONSENT_REGISTRY_TABLE=LikenessGuard-ConsentRegistry
AUDIT_LOG_TABLE=LikenessGuard-AuditLog
FEDERATION_TABLE=LikenessGuard-Federation
SUSPENSION_TABLE=LikenessGuard-Suspensions

# ── S3 Buckets ────────────────────────────────────────────────────────────────
# Bucket for uploaded reference photos (face images)
PHOTO_BUCKET=likenessguard-photos-YOUR_ACCOUNT_ID

# Bucket for the JWKS public key (used by third parties to verify Proof-of-Face)
JWKS_BUCKET=likenessguard-jwks-YOUR_ACCOUNT_ID

# Bucket for long-term audit log archives (7-year retention)
AUDIT_ARCHIVE_BUCKET=likenessguard-audit-archive-YOUR_ACCOUNT_ID

# ── KMS (Proof-of-Face Signing) ──────────────────────────────────────────────
# ARN of the KMS ECDSA P-256 key used to sign Proof-of-Face certificates
KMS_SIGNING_KEY_ARN=arn:aws:kms:us-east-1:YOUR_ACCOUNT_ID:key/YOUR_KEY_ID

# Alias for the KMS signing key (human-readable reference)
KMS_KEY_ALIAS=alias/likenessguard-pof-signing

# ── OpenSearch Serverless ─────────────────────────────────────────────────────
# Endpoint for the OpenSearch Serverless collection (k-NN vector search)
# Format: COLLECTION_ID.us-east-1.aoss.amazonaws.com
OPENSEARCH_ENDPOINT=YOUR_COLLECTION_ID.us-east-1.aoss.amazonaws.com

# Feature flag: set to "true" to use OpenSearch for vector similarity search
# Set to "false" to fall back to DynamoDB-only mode (no vector similarity)
USE_OPENSEARCH=true

# ── Bedrock ───────────────────────────────────────────────────────────────────
# Region for Bedrock API calls (must match where models are enabled)
BEDROCK_REGION=us-east-1

# ── JWKS / CloudFront ─────────────────────────────────────────────────────────
# Public URL where the JWKS (JSON Web Key Set) is hosted for signature verification
JWKS_URL=https://YOUR_CLOUDFRONT_DOMAIN/.well-known/jwks.json

# ── Similarity Thresholds ─────────────────────────────────────────────────────
# Minimum cosine similarity score (0.0–1.0) to consider a face match
# Higher = stricter matching, lower = more permissive
SIMILARITY_THRESHOLD=0.85

# ── Lambda Function Names ─────────────────────────────────────────────────────
# Names of the deployed Lambda functions (match CloudFormation resource names)
ANOMALY_AGENT_FN=LikenessGuard-AnomalyAgent
ORCHESTRATOR_FN=LikenessGuard-ConsentOrchestrator
POLICY_REASONER_FN=LikenessGuard-PolicyReasoner

# ── Edge (Greengrass v2) ─────────────────────────────────────────────────────
# API endpoint for edge device sync (same as API_BASE_URL)
LG_API_ENDPOINT=https://YOUR_API_GATEWAY_ID.execute-api.us-east-1.amazonaws.com/v1

# Similarity threshold for edge-side matching
LG_SIMILARITY_THRESHOLD=0.85

# Maximum number of cached consent records on the edge device
LG_CACHE_MAX_ENTRIES=10000

# Sync interval in seconds — how often the edge device pulls updates from cloud
LG_SYNC_INTERVAL=300

# Local SQLite database path for edge consent cache
LG_DB_PATH=/var/lib/likenessguard/edge_cache.db

# ── MCP Server (Claude.ai Integration) ───────────────────────────────────────
# Port for the MCP server that enables Claude.ai consent enforcement
MCP_PORT=8080

# ── Dashboard ─────────────────────────────────────────────────────────────────
# API base URL used by the React dashboard (Vite environment variable)
VITE_API_BASE_URL=https://YOUR_API_GATEWAY_ID.execute-api.us-east-1.amazonaws.com/v1
