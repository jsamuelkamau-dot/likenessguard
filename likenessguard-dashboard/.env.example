# LikenessGuard Dashboard Environment Configuration
# Copy this file to .env.local and update with your values

# Environment (development, staging, production)
VITE_APP_ENV=development

# API Base URL (optional - overrides environment-specific defaults)
# Development: http://localhost:3000/api
# Staging: https://staging-api.likenessguard.com
# Production: https://api.likenessguard.com
# VITE_API_BASE_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com/prod
