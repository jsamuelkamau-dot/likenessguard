{
  "manifest_version": 3,
  "name": "EasyPiky",
  "version": "1.0.0",
  "description": "Personal anti-phishing protection that prevents impersonation-based attacks through privacy-first URL analysis",
  
  "permissions": [
    "storage",
    "webNavigation",
    "activeTab",
    "scripting"
  ],
  
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "EasyPiky - Anti-Phishing Protection"
  },
  
  "options_page": "options.html",
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
